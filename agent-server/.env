# Timeout before the server shuts itself down due to inactivity (in minutes)
# Default is 120 minutes (2 hours)
INACTIVITY_TIMEOUT_MINUTES=120

# BROWSER_MODE determines how the agent interacts with Chrome.
# 'active' = Connects to your existing open Chrome window (requires Chrome to be launched with --remote-debugging-port=9222)
# 'dedicated' = Launches a separate, clean Chrome window specifically for job hunting when the server starts.
BROWSER_MODE=dedicated
