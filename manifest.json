{
  "manifest_version": 3,
  "name": "Auto Resume Filler",
  "version": "1.0",
  "description": "Generate tailored cover letters using Gemini API",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "<all_urls>",
    "http://localhost:*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
