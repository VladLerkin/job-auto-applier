{
  "manifest_version": 3,
  "name": "job-auto-applier",
  "version": "1.3.3",
  "key": "",
  "description": "Generate tailored cover letters using Gemini API",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "<all_urls>",
    "http://localhost:*/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
